// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Restaurante {
  id           Int      @id @default(autoincrement())
  nome         String
  tipoCozinha  String
  endereco     String
  telefone     String
  email        String?
  cnpj         String   @unique
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  usuarios          Usuario[]
  produtos          Produto[]
  itensListaCompras ItemListaCompras[]
  registrosImpacto  RegistroImpacto[]

  @@map("restaurantes")
}

model Usuario {
  id            Int         @id @default(autoincrement())
  nome          String
  email         String      @unique
  senhaHash     String
  cargo         String      @default("DONO")
  restauranteId Int
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  criadoEm      DateTime    @default(now())
  atualizadoEm  DateTime    @updatedAt

  @@map("usuarios")
}

model Produto {
  id                 Int         @id @default(autoincrement())
  nome               String
  codigoBarras       String?
  categoria          String
  localArmazenamento String
  quantidade         Float       @default(1)
  unidade            String      @default("un")
  precoUnitario      Float?
  fornecedor         String?
  dataValidade       DateTime
  situacao           String      @default("ATIVO")
  restauranteId      Int
  restaurante        Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  criadoEm           DateTime    @default(now())
  atualizadoEm       DateTime    @updatedAt

  registrosImpacto RegistroImpacto[]

  @@map("produtos")
}

model RegistroImpacto {
  id             Int         @id @default(autoincrement())
  produtoId      Int
  produto        Produto     @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  restauranteId  Int
  restaurante    Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  quantidadeKg   Float
  valorEstimado  Float
  foiAproveitado Boolean
  criadoEm       DateTime    @default(now())

  @@map("registros_impacto")
}

model ItemListaCompras {
  id            Int         @id @default(autoincrement())
  nome          String
  categoria     String?
  quantidade    Float       @default(1)
  unidade       String      @default("un")
  prioridade    Boolean     @default(false)
  comprado      Boolean     @default(false)
  restauranteId Int
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  criadoEm      DateTime    @default(now())

  @@map("itens_lista_compras")
}
